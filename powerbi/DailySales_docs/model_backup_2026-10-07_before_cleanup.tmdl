			column WeekDate
				isHidden
				formatString: General Date
				lineageTag: feaf68f6-81fc-4207-8411-68ed1d8e1c65
				summarizeBy: none
				isNameInferred
				sourceColumn: Calendar[WeekDate]
				columnOrigin: Calendar.WeekDate

				variation Variation
					isDefault
					relationship: 96aad893-6723-4a0e-9b7d-4ed788ca406b
					defaultHierarchy: LocalDateTable_bad6662c-a1a9-45b7-b101-077fa4b1a883.'Date Hierarchy'

				annotation SummarizationSetBy = Automatic

			column revenue
				isHidden
				lineageTag: 03930b00-d1a2-422e-8426-66b620413691
				summarizeBy: sum
				isNameInferred
				sourceColumn: [revenue]

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			column '% of Max weekday revenue' =
					
					
					Var Maxi =
					
					calculate(max('Max sales previous wk1'[Ave revenue / weekday]), filter(all('Max sales previous wk1'),'Max sales previous wk1'[Date]))
					
					var result =
					divide('Max sales previous wk1'[Ave revenue / weekday], Maxi,0)
					
					Return
					
					result
				isHidden
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: d5b4d1a8-bfde-42f5-9fce-f143d6603fcd
				summarizeBy: sum

				changedProperty = FormatString

				annotation SummarizationSetBy = Automatic

			column Weekday
				isHidden
				lineageTag: 096e4d39-a112-4ff1-a756-28d737137f52
				summarizeBy: none
				isNameInferred
				sourceColumn: Calendar[Weekday]
				sortByColumn: weekdaynum
				columnOrigin: Calendar.Weekday

				changedProperty = SortByColumn

				annotation SummarizationSetBy = Automatic

			column 'Ave revenue / weekday' =
					
					CALCULATE(AVERAGE('Max sales previous wk1'[revenue]), filter('Max sales previous wk1', 'Max sales previous wk1'[Weekday] = EARLIER('Max sales previous wk1'[Weekday])))
				isHidden
				formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
				lineageTag: ea5a1089-f601-41c1-9924-667580604b82
				summarizeBy: sum

				changedProperty = FormatString

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"currencyCulture":"af-ZA"}

			column weekdaynum = ```
					
					
					WEEKDAY('Max sales previous wk1'[Date],2)
					
					
					```
				isHidden
				formatString: 0
				lineageTag: c143dfd5-2b5a-44bf-8c04-f3e80492d0c8
				summarizeBy: sum

				annotation SummarizationSetBy = Automatic

			partition 'Max sales previous wk1-00a46821-f051-4fa4-8f71-488b74c00a6c' = calculated
				mode: import
				source = ```
						
						
						
						    SUMMARIZE(
						        filter('Calendar', 'Calendar'[Date] <=TODAY() &&'Calendar'[Year] = YEAR(TODAY())),
						        'Calendar'[Date],
						        'Calendar'[Weekday],
						        'Calendar'[WeekDate],
						        "revenue", 
						        [Total new revenue]
						    )
						```

			annotation PBI_Id = c28899441dbe466293f1a00fddd57b62

