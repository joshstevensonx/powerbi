			column Month = format('Combined Revenue'[create_date], "MMM")
				lineageTag: db12ebfb-cd47-401e-bcd5-70da66e186cd
				summarizeBy: none

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

			column Register/Transfer = if(CONTAINSSTRING('Combined Revenue'[Invoice type], "Transfer"), "Transfer", IF(CONTAINSSTRING('Combined Revenue'[Invoice type], "Register"), "Register", "Unknown"))
				lineageTag: a31f6628-b25a-4185-9a28-c5ec414a6e04
				summarizeBy: none

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

			column 'Signup date' = LOOKUPVALUE(Clients[SignDate], Clients[client_id], 'Combined Revenue'[client_id])
				formatString: yyyy/mm/dd
				lineageTag: 1d3a015b-7d7b-499a-9579-07567c60ccf4
				summarizeBy: none

				variation Variation
					isDefault
					relationship: 22f7df74-fb14-434b-9ee3-11b95786fd8e
					defaultHierarchy: LocalDateTable_f46a8c7d-8329-48d3-b382-85b516b56647.'Date Hierarchy'

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

				annotation UnderlyingDateTimeDataType = Date

				annotation PBI_FormatHint = {"isDateTimeCustom":true}

			column 'Type of customer' = if('Combined Revenue'[Signup date] = 'Combined Revenue'[Invoice date], "New", "Existing")
				lineageTag: 28e5acab-b36e-49af-854f-c2a276a7a74e
				summarizeBy: none

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

			column 'Calculated sales revenue' = ```
					IF(
					    'Combined Revenue'[Invoice status] = "Cancelled", 0, 
					    SWITCH(TRUE(),
					    CONTAINSSTRING('Combined Revenue'[service_type],"Once-Off Website Design"), ('Combined Revenue'[revenue]/4) + 'Combined Revenue'[setup_fee]/1.15,
					    'Combined Revenue'[product_2] = "SSL",'Combined Revenue'[SSL lookup],
					    and('Combined Revenue'[product_1] = "Company Registration", 'Combined Revenue'[create_date] < 2021/06/21),'Combined Revenue'[Company reg lookup],
					    and('Combined Revenue'[product_1] = "Company Registration", 'Combined Revenue'[create_date] >= 2021/06/21),'Combined Revenue'[Company reg lookup discount],
					    'Combined Revenue'[product_2]= "Domain",'Combined Revenue'[Domain_amount],
					    'Combined Revenue'[revenue] + 'Combined Revenue'[setup_fee]/1.15)
					)
					```
				formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
				lineageTag: 0015a1a0-1e1d-47b3-91fb-f82ecaba8502
				summarizeBy: sum

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"currencyCulture":"af-ZA"}

			column 'Company reg lookup discount' = if('Combined Revenue'[Company reg lookup] > 0, 749/1.15,0)
				formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
				lineageTag: b3f62b93-a60e-45fa-bd0f-9b7ba409a423
				summarizeBy: sum

