				annotation PBI_FormatHint = {"isGeneralNumber":true}

			partition 'Max sales previous wk-226654bf-7ee2-4e0a-b67a-5708378eb180' = calculated
				mode: import
				source = ```
						
						
						TOPN(
						    1,
						    SUMMARIZE(
						        filter('Calendar','Calendar'[Week of Year] = WEEKNUM(TODAY(),1)-1 && 'Calendar'[Year] = YEAR(TODAY())),
						        'Calendar'[Date],
						        'Calendar'[WeekDate],
						        "revenue", 
						        [Total new revenue]
						    ),
						    [revenue],
						    DESC
						)
						```

			annotation PBI_Id = 2514867077b6482eb046229a4d26f55b

