					relationship: 8f7694e1-92de-46c8-bc18-2e6b23272d21
					defaultHierarchy: LocalDateTable_190c0c9d-9cd3-4093-9419-18feee1e0c9e.'Date Hierarchy'

				annotation SummarizationSetBy = Automatic

			column product_1
				isHidden
				lineageTag: f26043ba-eb46-4441-8d77-c115bd3304f2
				summarizeBy: none
