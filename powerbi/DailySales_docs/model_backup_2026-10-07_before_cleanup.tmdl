				annotation UnderlyingDateTimeDataType = Date

			column 'Invoice payment method' = LOOKUPVALUE('Invoice detail'[invoice_payment_method], 'Invoice detail'[invoice_id], 'Combined Revenue'[invoice_id])
				lineageTag: 1e6ed534-6a1a-4f03-87a9-1d104e94251b
				summarizeBy: none

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

			column 'Invoice status' = LOOKUPVALUE('orders_invoices_tbl'[invoice_status], 'orders_invoices_tbl'[order_invoiceid], 'Combined Revenue'[invoice_id])
				lineageTag: a5817d73-675d-4bb1-a485-7a80153a6fee
				summarizeBy: none

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

			column 'Invoice type' = if('Combined Revenue'[product_1] = "Domain", CONCATENATEX(filter('Invoice detail', 'Invoice detail'[invoice_id] = 'Combined Revenue'[invoice_id]), 'Invoice detail'[invoice_type], ","))
				lineageTag: d4c037d4-dc54-4c43-99f9-983cb5061824
