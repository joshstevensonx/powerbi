			column Criteria =
					//calculate(FIRSTNONBLANK('Invoice detail'[Criteria], 'Invoice detail'[Criteria]), filter(all('Invoice detail'), 'Combined Revenue'[service_id] = 'Invoice detail'[item_id]))
					var tbl = FILTER(ALL('Invoice detail'), 'Combined Revenue'[service_id] = 'Invoice detail'[item_id])
					return
					MAXX(tbl,'Invoice detail'[Criteria])
				lineageTag: 5963c403-9b7f-4463-bf3b-a586b3016a22
				summarizeBy: none

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

			column Domain_amount =
					//if('Combined Revenue'[domain] = "gator.global", 0, value(if(and('Combined Revenue'[Criteria]= "Yes" ,'Combined Revenue'[product_2] = "Domain") ,iferror(LOOKUPVALUE('Invoice detail'[item_amount],'Invoice detail'[item_id],'Combined Revenue'[service_id]),0),0) /1.15))
					var tbl = FILTER(ALL('Invoice detail'), 'Combined Revenue'[service_id] = 'Invoice detail'[item_id])
					return
					if('Combined Revenue'[domain] = "gator.global", 0, MAXX(tbl,'Invoice detail'[item_amount])/1.15)
