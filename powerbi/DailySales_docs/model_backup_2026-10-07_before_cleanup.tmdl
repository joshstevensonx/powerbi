			partition LocalDateTable_190c0c9d-9cd3-4093-9419-18feee1e0c9e = calculated
				mode: import
				source = Calendar(Date(Year(MIN('Combined_rev Summary 2'[Invoice date])), 1, 1), Date(Year(MAX('Combined_rev Summary 2'[Invoice date])), 12, 31))

			annotation __PBI_LocalDateTable = true

		table revenue_orders_tbl
			lineageTag: 37ff34c6-49c3-4f39-a30b-574cfbeda116

			measure 'Unpaid / Cancelled Invoice Total' = /* Total value EXCL. VAT of invoices that are Unpaid or Cancelled. Each invoice is counted once, even though its total is repeated on every service row of revenue_orders_tbl. */ CALCULATE ( SUMX ( VALUES ( revenue_orders_tbl[order_id] ), CALCULATE ( MAX ( revenue_orders_tbl[invoice_total] ) * MAX ( revenue_orders_tbl[vat_factor] ) ) ), revenue_orders_tbl[Status_Filter] IN { "Unpaid", "Cancelled" } )
				lineageTag: f315e581-77a6-4d40-b173-0fc58ef28314

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Paid Invoice Total' = /* Total value of Paid invoices EXCL. VAT, each invoice counted once. */ CALCULATE ( SUMX ( VALUES ( revenue_orders_tbl[order_id] ), CALCULATE ( MAX ( revenue_orders_tbl[invoice_total] ) * MAX ( revenue_orders_tbl[vat_factor] ) ) ), revenue_orders_tbl[Status_Filter] = "Paid" )
				lineageTag: 2c7f88dd-9c0c-45d2-885b-cadeca4091fd

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'RO Invoice Total' = /* Invoice totals EXCL. VAT, each invoice counted once. */ SUMX ( VALUES ( revenue_orders_tbl[invoice_id] ), CALCULATE ( MAX ( revenue_orders_tbl[invoice_total] ) * MAX ( revenue_orders_tbl[vat_factor] ) ) )
				lineageTag: 116ba98d-b54c-4e37-a8fe-86b57118258a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Paid Revenue (Products)' =
					
					/* Paid revenue EXCL. VAT, attributed to revenue_orders_tbl[Revenue Date]
					   (paid date for paid invoices, otherwise order date).
					   The Calendar selection is moved onto Revenue Date. Order counts stay on order date. */
					VAR _dates = VALUES ( 'Calendar'[Date (format)] )
					RETURN
					    CALCULATE (
					        SUMX (
					            revenue_orders_tbl,
					            revenue_orders_tbl[invoice_total_alloc] * revenue_orders_tbl[vat_factor]
					        ),
					        revenue_orders_tbl[invoice_status] = "Paid",
					        REMOVEFILTERS ( 'Calendar' ),
					        TREATAS ( _dates, revenue_orders_tbl[Revenue Date] )
					    )
				formatString: "R"\ #,0.00;"R"-#,0.00;"R"\ #,0.00
				lineageTag: 3b06c17e-36cb-4b43-b7aa-82e5c7e735a0

				annotation PBI_FormatHint = {"currencyCulture":"af-ZA"}

			measure 'Paid Orders (Products)' = /* Distinct paid orders above R0, attributed to Revenue Date (invoice paid date), the same basis as Paid Revenue (Products). */ VAR _dates = VALUES ( 'Calendar'[Date (format)] ) RETURN CALCULATE ( DISTINCTCOUNT ( revenue_orders_tbl[order_id] ), revenue_orders_tbl[invoice_status] = "Paid", revenue_orders_tbl[invoice_total] > 0, REMOVEFILTERS ( 'Calendar' ), TREATAS ( _dates, revenue_orders_tbl[Revenue Date] ) )
				formatString: 0
				lineageTag: 11367ada-618e-4bca-90da-dd7059de8831

			measure 'Unpaid Revenue (Products)' = /* Invoice totals EXCL. VAT split across products, for every invoice that isn't Paid (Unpaid, Cancelled, Refunded, etc.). Orders with no invoice are excluded. */ CALCULATE ( SUMX ( revenue_orders_tbl, revenue_orders_tbl[invoice_total_alloc] * revenue_orders_tbl[vat_factor] ), revenue_orders_tbl[invoice_status] <> "Paid", NOT ISBLANK ( revenue_orders_tbl[invoice_status] ) )
				formatString: "R"\ #,0.00;"R"-#,0.00;"R"\ #,0.00
				lineageTag: e3605ac3-5602-4a4c-a504-74c89e04ee03

				annotation PBI_FormatHint = {"currencyCulture":"af-ZA"}

			measure 'Unpaid Orders (Products)' = /* Distinct orders whose invoice isn't Paid and is above R0, attributed to Revenue Date (= order date for unpaid rows). */ VAR _dates = VALUES ( 'Calendar'[Date (format)] ) RETURN CALCULATE ( DISTINCTCOUNT ( revenue_orders_tbl[order_id] ), revenue_orders_tbl[invoice_status] <> "Paid", NOT ISBLANK ( revenue_orders_tbl[invoice_status] ), revenue_orders_tbl[invoice_total] > 0, REMOVEFILTERS ( 'Calendar' ), TREATAS ( _dates, revenue_orders_tbl[Revenue Date] ) )
				formatString: 0
				lineageTag: 6fa98156-b8a6-474a-87e9-909c90e6466c

