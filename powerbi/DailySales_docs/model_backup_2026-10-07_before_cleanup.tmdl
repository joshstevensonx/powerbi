			column today = TODAY()
				formatString: General Date
				lineageTag: c37f888f-a227-4695-9638-a958e34c2509
				summarizeBy: none

				variation Variation
					isDefault
					relationship: f95163d1-9c71-446c-ab92-95d2beaf09d6
					defaultHierarchy: LocalDateTable_0d90986d-daaa-4e23-a82e-1893c3697a7f.'Date Hierarchy'

				annotation SummarizationSetBy = Automatic

			column 'Invoice Status Group' =
					
					SWITCH (
					    TRUE (),
					    orders_invoices_tbl[invoice_status] = "Paid", "Paid Invoice",
					    orders_invoices_tbl[invoice_status] = "Unpaid"
					        && orders_invoices_tbl[invoice_paymethod] = "mygateDebit"
					        && orders_invoices_tbl[invoice_duedate] > TODAY (), "Pending Debit Order",
					    orders_invoices_tbl[invoice_status]
					)
				lineageTag: 34c2c5ad-47fb-4ce7-b855-b91e81f109ae
				summarizeBy: none

				annotation SummarizationSetBy = Automatic

