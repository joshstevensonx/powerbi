			measure 'old Total' = sum(Calculator[Combined revenue]) + SUM(Calculator[Add-on revenue])
				formatString: "R"#,0;-"R"#,0;"R"#,0
				isHidden
				lineageTag: 897bb044-3a3c-437d-86cb-3b167942e9c6

				changedProperty = IsHidden

