				annotation SummarizationSetBy = Automatic

			column 'Customer age group' = LOOKUPVALUE(Clients[Age grouping], Clients[client_id], 'Combined Revenue'[client_id])
				lineageTag: 3692d9c9-b946-4d91-aa13-366f7272814c
