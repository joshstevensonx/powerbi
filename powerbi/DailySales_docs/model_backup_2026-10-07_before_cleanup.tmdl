		table 'Max sales previous wk1'
			isHidden
			lineageTag: 26730472-ed86-4b9c-b35f-c423b760cb23

			column Date
				isHidden
				formatString: General Date
				lineageTag: 1da18910-1a3f-4292-8901-d25c9840e539
