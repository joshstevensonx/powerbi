					-- LOOKUPVALUE(tblinvoices[date],tblinvoices[id], 'Combined Revenue'[invoice_id])
				formatString: Long Date
				lineageTag: cad97187-9954-4bcc-a6c4-5e9767da3d04
				summarizeBy: none

				variation Variation
					isDefault
					relationship: 4604794c-910f-4057-a9e8-4f4b72040faa
